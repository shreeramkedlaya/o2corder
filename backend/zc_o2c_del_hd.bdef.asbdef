projection;
strict ( 2 );
use draft;

define behavior for ZC_O2C_DEL_HD alias DeliveryHeader
{
  use create;
  use update;
  use delete;

  use action postGoodsIssue;
  use action createInvoice;

  use association _DeliveryItems { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

}

define behavior for ZC_O2C_DEL_IT alias DeliveryItem
{
  use update;
  use delete;

  use association _DeliveryHeader { with draft; }
}